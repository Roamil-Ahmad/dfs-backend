# =============================================================================
#  DFS Pakistan — environment template
# =============================================================================
#  Copy this file and fill in the real values:
#      cp .env.example .env
#
#  .env is git-ignored. NEVER commit real credentials.
#  The server SSH password does not belong in this file, or anywhere in the repo.
#
#  Every variable below is read by docker compose (via `env_file: [.env]`) and
#  passed into the containers. To run a service directly on the host instead,
#  export the same variables in your shell before `mvn spring-boot:run`.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — REQUIRED. Every service fails to start without these.
# -----------------------------------------------------------------------------
# Oracle runs OUTSIDE this compose project. There is no database container; the
# services connect to an existing Oracle instance over the network.
DB_URL=jdbc:oracle:thin:@<oracle-host>:1521/<service-name>
DB_USERNAME=<schema-user>
DB_PASSWORD=<schema-password>

# -----------------------------------------------------------------------------
# Secrets — REQUIRED. These have no defaults; a missing value stops the Spring
# context with "Could not resolve placeholder", so the container crash-loops
# rather than starting in a degraded state.
# -----------------------------------------------------------------------------
AGENTAPP_PORTAL_TOKEN=

# Shared key the Corporate Portal presents in the X-Portal-Key header to reach the token-free
# changempin / getbalance / miniStatment replicas. Generate a long random value per environment.
CORPORATE_PORTAL_API_KEY=
MOBILE_CLIENT_SECRET=
POS_CLIENT_SECRET=
AGENT_CLIENT_SECRET=

# PKG_MW authentication triple (Transactions → switching).
# The stored procedure validates CLIENT_SECRET + CHANNEL_CODE + USER_ID
# together against TBL_MW_CHANNEL; all three must match one row.
MW_CLIENT_SECRET=
MW_CHANNEL_CODE=
MW_USER_ID=

# apigatway-encryption AES-256 key, base64. Leave blank to keep the image default.
DFS_AES_KEY=

# -----------------------------------------------------------------------------
# Mail — optional. Blank disables outbound mail rather than failing startup.
# App and backoffice share one account; ThirdParties uses its own.
# -----------------------------------------------------------------------------
MAIL_USERNAME=
MAIL_PASSWORD=
THIRDPARTIES_MAIL_USERNAME=
THIRDPARTIES_MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Host port mapping — the left-hand side of each compose port binding.
# Change these to resolve conflicts on your machine; the in-container ports
# (SERVER_PORT, below) do not need to change with them.
# -----------------------------------------------------------------------------
AGENTAPP_HOST_PORT=18001
APP_HOST_PORT=18002
BACKOFFICE_HOST_PORT=18003
CARDWRAPPER_HOST_PORT=18005
FEE_HOST_PORT=18007
THIRDPARTIES_HOST_PORT=18008
TRANSACTIONS_HOST_PORT=18009
WORKFLOW_HOST_PORT=18010
PUSHNOTIFICATION_HOST_PORT=18012
GATEWAY_HOST_PORT=18013
NADRA_HOST_PORT=18014
SWITCH_GATEWAY_HOST_PORT=18015
SWITCH_SIMULATOR_HOST_PORT=18016

# -----------------------------------------------------------------------------
# Service-to-service URLs.
#
# The defaults compiled into application.properties are the DOCKER values —
# each service is reachable at http://<compose-service-name>:<container-port>
# on the shared dfs-net network, so compose needs no overrides here.
#
# Uncomment and adjust ONLY when running services directly on the host, where
# they must address each other through localhost and the HOST ports above.
# -----------------------------------------------------------------------------
#AGENTAPP_BASE_URL=http://localhost:18001/agentapp
#APP_BASE_URL=http://localhost:18002/app
#TRANSACTIONS_BASE_URL=http://localhost:18009/transactions
#WORKFLOW_BASE_URL=http://localhost:18010/workflow
#THIRDPARTIES_BASE_URL=http://localhost:18008/thirdparties
#CARD_BASE_URL=http://localhost:18005/cardwrapper
#PUSHNOTIFICATION_BASE_URL=http://localhost:18012/firbase
#NADRA_BASE_URL=http://localhost:18014/nadra
#SWITCH_GATEWAY_BASE_URL=http://localhost:18015/switch-gateway
#SWITCH_SIMULATOR_HOST=localhost
# NOTE: 6661 is the simulator ISO-8583 socket, NOT its HTTP port (9993).
#SWITCH_SIMULATOR_PORT=6661
#DFS_APP_BASE_URL=http://localhost:18002/app
#DFS_DC_BASE_URL=http://localhost:18005/cardwrapper

# In-container listen port. Each service defaults to its own value; override
# only when running two copies of the same service side by side.
#SERVER_PORT=

# -----------------------------------------------------------------------------
# External systems — real third-party endpoints, not container addresses.
# Leave these pointing at the provider, never at a compose service name.
# -----------------------------------------------------------------------------
APS_BASE_URL=
CARD_PROCESSOR_URL=

# googleauth is referenced by App and backoffice but is not part of this
# repository. Point this at wherever that service actually runs, or the auth
# paths that use it will fail.
GOOGLEAUTH_BASE_URL=
